EXPO_PUBLIC_DATA_SOURCE=api
# Expo Go 開発: false / EAS・Dev Client ビルド: true
EXPO_PUBLIC_ENABLE_ADMOB=false
# BFF API URL
EXPO_PUBLIC_API_BASE_URL=http://<実機のIP>:3000
# 本番 BFF 例
# EXPO_PUBLIC_API_BASE_URL=https://7rxd12rw2j.execute-api.ap-northeast-1.amazonaws.com
# 対人マッチング WebSocket（matching_server.shogi の bun run dev:ws、既定ポート 3010）
EXPO_PUBLIC_MATCHING_SERVER_WS_URL=ws://<実機のIP>:3010/ws
# 本番 matching server 例
# EXPO_PUBLIC_MATCHING_SERVER_WS_URL=wss://oe65x15z0g.execute-api.ap-northeast-1.amazonaws.com/prod
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# AdMob interstitial ad unit ID. This is different from the app ID (`ca-app-pub-...~...`).
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-4722276667311883/8991247351
