{
  "name": "frontend",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --clear",
    "start:lan:clear": "expo start --lan --clear",
    "start:tunnel:clear": "expo start --tunnel --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform ios --output-dir /tmp/shogi-mobile-app-export-ios --clear",
    "build:check": "expo export --platform ios --output-dir /tmp/shogi-mobile-app-export-ios --clear && expo export --platform android --output-dir /tmp/shogi-mobile-app-export-android --clear",
    "lint": "expo lint",
    "sync:piece-images": "node ./scripts/sync-piece-images-from-supabase.mjs",
    "sync:battle-piece-effect-sounds": "node ./scripts/sync-battle-piece-effect-sounds.mjs",
    "load:matching": "bun ./scripts/matching-load-test.ts",
    "load:matchmaking": "bun ./scripts/matching-load-test.ts --scenario matchmaking",
    "load:spike": "bun ./scripts/matching-load-test.ts --scenario spike",
    "load:gameplay": "bun ./scripts/matching-load-test.ts --scenario gameplay",
    "load:reconnect": "bun ./scripts/matching-load-test.ts --scenario reconnect",
    "load:soak": "bun ./scripts/matching-load-test.ts --scenario soak",
    "format": "biome format src docs scripts README.md package.json tsconfig.json app.config.js babel.config.js eslint.config.js jest.config.js jest.setup.ts metro.config.js tailwind.config.js --write",
    "format:check": "biome format src docs scripts README.md package.json tsconfig.json app.config.js babel.config.js eslint.config.js jest.config.js jest.setup.ts metro.config.js tailwind.config.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "online:validate-move": "bun ./dist/online-move-validator.js",
    "build:online-validator": "bun build ./scripts/online-move-validator.ts --outdir=./dist --target=bun",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.98.0",
    "dotenv": "^17.4.1",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^0.577.0",
    "nativewind": "^4.2.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "lefthook": "^2.1.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "bun@1.3.6"
}
